# Disable directory browsing
Options -Indexes

# Allow large media uploads handled by PHP/cPanel limits
LimitRequestBody 0

# index.php prerenders <head> and content for crawlers, then hands over to React.
# index.html stays as a static fallback if PHP is ever unavailable.
DirectoryIndex index.php index.html

# Enable BrowserRouter (SPA) Fallback
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTP_HOST} ^www\.pavlokovach\.art$ [NC]
  RewriteRule ^ https://pavlokovach.art%{REQUEST_URI} [R=301,L]
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP_HOST} ^pavlokovach\.art$ [NC]
  RewriteRule ^ https://pavlokovach.art%{REQUEST_URI} [R=301,L]
  RewriteBase /

  # Sitemap is generated from the live content.json.
  RewriteRule ^sitemap\.xml$ /sitemap.php [L]

  # Internal include — never serve it directly.
  RewriteRule ^_prerender\.php$ - [F,L]

  # /index.html and /index.php are reachable duplicates of "/". Matching on
  # THE_REQUEST (the literal request line) means the internal DirectoryIndex
  # subrequest for "/" does not match, so this cannot loop.
  RewriteCond %{THE_REQUEST} \s/index\.(html|php)[\s?] [NC]
  RewriteRule ^index\.(html|php)$ / [R=301,L]

  RewriteCond %{REQUEST_URI} !^/api/
  RewriteCond %{REQUEST_URI} !^/uploads/
  RewriteCond %{REQUEST_URI} !^/robots\.txt$
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.php [L]
</IfModule>

# Enable Gzip Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/x-javascript application/json image/svg+xml application/xml
</IfModule>

# Browser Caching
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType application/json "access plus 0 seconds"
  ExpiresByType application/xml "access plus 0 seconds"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType video/mp4 "access plus 1 year"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
</IfModule>

# Vite emits content-hashed filenames (index-YFnAN_39.js), so a new build is a
# new URL — these can be cached permanently.
<IfModule mod_headers.c>
  <FilesMatch "-[A-Za-z0-9_-]{8,}\.(js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

# Security Headers
<IfModule mod_headers.c>
  Header set X-Content-Type-Options "nosniff"
  Header set X-Frame-Options "SAMEORIGIN"
  Header set Referrer-Policy "strict-origin-when-cross-origin"
  Header set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  Header set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; media-src 'self' data: https:; connect-src 'self';"
</IfModule>
